{
  "name": "pebble-opencode",
  "author": "OpenCode for Pebble contributors",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "python3 scripts/build.py"
  },
  "pebble": {
    "displayName": "OpenCode",
    "uuid": "4e2c758f-8a31-4bf2-a6d9-7c40ec9b5173",
    "manifestVersion": 2,
    "sdkVersion": "3",
    "usesPermissions": [
      "Internet",
      "LocalNetwork"
    ],
    "plugin": {
      "description": "Send messages to OpenCode and expose active sessions, attention, and activity summary.",
      "script": "src/plugin/index.js",
      "sources": [
        {
          "category": "agent",
          "items": [
            "chats"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "title": [
              "shortText"
            ],
            "url": [
              "longText"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 900
        },
        {
          "category": "agent",
          "items": [
            "configured"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "configured": [
              "boolean",
              "shortText"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 60
        },
        {
          "category": "opencode",
          "items": [
            "active_session"
          ],
          "properties": {
            "name": [
              "shortText",
              "longText"
            ],
            "title": [
              "longText"
            ],
            "status": [
              "shortText",
              "longText"
            ],
            "directory": [
              "longText"
            ],
            "agent": [
              "longText"
            ],
            "model": [
              "longText"
            ],
            "updated": [
              "timestamp"
            ],
            "url": [
              "longText"
            ],
            "is_subagent": [
              "boolean"
            ]
          },
          "supportsMultiple": true,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 20
        },
        {
          "category": "opencode",
          "items": [
            "activity"
          ],
          "properties": {
            "name": [
              "shortText",
              "longText"
            ],
            "active_count": [
              "numericValue",
              "shortText"
            ],
            "attention_count": [
              "numericValue",
              "shortText"
            ],
            "summary": [
              "shortText",
              "longText"
            ],
            "connected": [
              "boolean"
            ],
            "checked_at": [
              "timestamp"
            ]
          },
          "supportsMultiple": false,
          "callerPermissions": [],
          "suggestedRefreshIntervalSec": 20
        }
      ],
      "actions": [
        {
          "name": "send_to_agent",
          "description": "Send a message to an existing OpenCode session or start a new session in a directory. chat_id may identify a session by its ID, nickname, or unambiguous title; use \"new\" to start a session in the configured directory. Omit chat_id to follow settings: use the configured default session or start a new one. Returns a queued receipt, not OpenCode's reply. Do not automatically retry uncertain delivery or conflicts.",
          "parameters": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000,
                "description": "Message to send to OpenCode."
              },
              "chat_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Session ID, nickname, or unambiguous title. Use \"new\" to start a session in the configured directory; omit to follow settings."
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          },
          "targets": [
            "agent/chats"
          ],
          "destructive": false,
          "requiresConfirmation": false,
          "callerPermissions": []
        }
      ]
    },
    "configPage": "src/config.html",
    "projectType": "plugin"
  }
}
